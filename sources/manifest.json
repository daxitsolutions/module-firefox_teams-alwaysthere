{
  "manifest_version": 3,
  "name": "Teams AlwaysThere",
  "version": "1.0.0",
  "description": "Aide à maintenir une activité périodique sur les onglets Teams quand l'extension est activée.",
  "permissions": [
    "alarms",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "*://teams.cloud.microsoft/*",
    "*://teams.microsoft.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Teams AlwaysThere"
  },
  "background": {
    "scripts": ["background.js"],
    "service_worker": "background.js"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "teams-alwaysthere-firefox@example.local"
    }
  }
}
